# --- Local runtime data (never commit) ---
data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# --- Personal documents (CV, letters, references, certificates) ---
documents/*
!documents/.gitkeep

# --- Secrets / local configuration ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
venv/
.venv/
env/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Playwright ---
playwright-report/
test-results/
.playwright/

# --- Editors / OS ---
.DS_Store
.idea/
.vscode/
*.swp

# NOTE: schema + migrations live in jobscanner/db.py and jobscanner/schema_v2.py
