# Optional local configuration for the Job Assistant.
# Copy to .env only if you need it - .env is git-ignored and never committed.
# Nothing here is required; the application runs with all of it unset.

# --- Server ---
# JOB_ASSISTANT_PORT=8765
# JOB_ASSISTANT_HOST=127.0.0.1
# JOB_ASSISTANT_NO_BROWSER=0

# --- Database ---
# Override the SQLite location (default: ./data/app.db).
# JOB_TRACKER_DB=/absolute/path/to/app.db

# --- AI analysis (optional) ---
# API keys are read from the environment only and are never stored in SQLite.
# Set the matching one, then enable the provider under Config -> AI.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
