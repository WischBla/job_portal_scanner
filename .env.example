# Optional local configuration for the Job Portal Scanner.
# Copy to .env only if you need it - .env is git-ignored and never committed.

# TCP port for the local web UI (default 8765).
APPLICATION_TRACKER_PORT=8765

# Set to 1 to suppress the automatic browser window when running app.py directly.
APPLICATION_TRACKER_NO_BROWSER=0

# Override the SQLite database location (default: ./data/applications.db).
# JOB_TRACKER_DB=/absolute/path/to/applications.db
